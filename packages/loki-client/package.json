{
  "name": "@prodisco/loki-client",
  "version": "0.1.1",
  "description": "TypeScript client for Grafana Loki REST API",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
